# =============================================================================
# FRONTEND - ENVIRONMENT VARIABLES
# =============================================================================
# 
# This file contains environment variables needed for the frontend application.
# Copy this file to .env and fill in your actual values.
#
# IMPORTANT: Never commit your actual .env file to version control!
# =============================================================================

# =============================================================================
# MAPBOX TOKEN
# =============================================================================
# Used for displaying interactive maps showing vaccine hesitancy data
# by region, health board, or geographic location.

NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token-here

# How to get this value:
# 1. Go to https://account.mapbox.com/
# 2. Create a free account or sign in
# 3. Navigate to "Access tokens" in your account
# 4. Create a new token or copy an existing one
# 5. Make sure the token has the necessary scopes (public scope is fine for frontend)
# 6. Note: Free tier includes 50,000 map loads per month

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. Never commit your actual .env file to version control
# 2. The NEXT_PUBLIC_ prefix means this token will be exposed to the browser
# 3. This is safe for Mapbox public tokens as they're designed for client-side use
# 4. Monitor your Mapbox usage to stay within free tier limits
