# =============================================================================
# VACCINE HESITANCY PROJECT - ENVIRONMENT VARIABLES
# =============================================================================
# 
# This file contains all the environment variables needed to run the Vaccine
# Hesitancy project agents. Copy this file to .env and fill in your actual values.
#
# IMPORTANT: Never commit your actual .env file to version control!
# =============================================================================

# =============================================================================
# SUPABASE DATABASE CONFIGURATION
# =============================================================================
# These variables configure the connection to your Supabase PostgreSQL database
# where vaccine hesitancy data is stored.

# Supabase database connection details
SUPABASE_DB_HOST=db.your-project-id.supabase.co
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your-project-id
SUPABASE_DB_PASSWORD=your-database-password
SUPABASE_DB_PORT=5432

# Supabase project configuration
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_ACCESS_TOKEN=sbp_your-access-token
SUPABASE_SERVICE_ROLE=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# How to get these values:
# 1. Go to https://supabase.com and create/login to your project
# 2. Go to Settings > API to find your Project ID and API keys
# 3. Go to Settings > Database to find your database connection details
# 4. The service role key is in Settings > API > Project API keys

# =============================================================================
# SMITHERY MCP SERVICES
# =============================================================================
# Smithery.ai provides MCP (Model Context Protocol) servers for various services
# including Supabase integration and X (Twitter) data access.

SMITHERY_API_KEY=your-smithery-api-key

# MCP server URLs for different services
SUPABASE_MCP_URL=https://server.smithery.ai/@supabase-community/supabase-mcp/mcp?api_key=YOUR_KEY&profile=YOUR_PROFILE
X_MCP_URL=https://server.smithery.ai/@NexusX-MCP/x-v2-server/mcp?api_key=YOUR_KEY&profile=YOUR_PROFILE

# How to get these values:
# 1. Go to https://smithery.ai and create an account
# 2. Get your API key from your dashboard
# 3. Create profiles for the services you need (Supabase, X/Twitter)
# 4. Copy the MCP URLs from your profile configuration

# =============================================================================
# ASI1 API (FETCH.AI)
# =============================================================================
# ASI1 is Fetch.ai's AI model service used for intelligent query routing and
# response generation in the vaccine hesitancy analysis.

ASI1_API_KEY=sk_your-asi1-api-key

# How to get this value:
# 1. Go to https://innovationlab.fetch.ai/
# 2. Sign up for an account
# 3. Navigate to ASI:One section
# 4. Generate your API key
# 5. Note: Rate limited to 6 requests/hour for free tier

# =============================================================================
# X (TWITTER) API CONFIGURATION
# =============================================================================
# These variables enable access to X (Twitter) data for social media sentiment
# analysis related to vaccine hesitancy.

# X API v2 credentials
X_API_KEY=your-x-api-key
X_API_SECRET=your-x-api-secret
X_ACCESS_TOKEN=your-x-access-token
X_ACCESS_SECRET=your-x-access-secret
X_BEARER_TOKEN=your-x-bearer-token

# How to get these values:
# 1. Go to https://developer.twitter.com/
# 2. Create a developer account and app
# 3. Apply for Elevated access (required for most endpoints)
# 4. Generate your API keys and tokens in your app settings
# 5. Note: X API has rate limits and requires approval for research use

# =============================================================================
# QDRANT VECTOR DATABASE
# =============================================================================
# Qdrant is used for vector similarity search of vaccine-related documents
# and resources.

QDRANT_URL=https://your-cluster-id.us-west-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# How to get this value:
# 1. Go to https://cloud.qdrant.io/
# 2. Create a free account
# 3. Create a new cluster
# 4. Copy your cluster URL and API key from the dashboard

# =============================================================================
# OPENAI API
# =============================================================================
# OpenAI API is used for advanced language model capabilities in some agents.

OPENAI_API_KEY=sk-proj-your-openai-api-key

# How to get this value:
# 1. Go to https://platform.openai.com/
# 2. Create an account and add billing information
# 3. Generate an API key in your dashboard
# 4. Note: OpenAI API is pay-per-use

# =============================================================================
# RAPIDAPI (OPTIONAL)
# =============================================================================
# RapidAPI provides access to various third-party services and APIs.

RAPIDAPI_KEY=your-rapidapi-key

# How to get this value:
# 1. Go to https://rapidapi.com/
# 2. Sign up for an account
# 3. Subscribe to the APIs you need
# 4. Copy your API key from your dashboard

# =============================================================================
# AGENT-SPECIFIC CONFIGURATION
# =============================================================================
# Some agents may have additional environment variables specific to their
# functionality. Check the individual agent directories for more details.

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. Never commit your actual .env file to version control
# 2. Use strong, unique passwords for database connections
# 3. Rotate API keys regularly
# 4. Monitor API usage to avoid unexpected charges
# 5. Use environment-specific configurations for development/staging/production

# =============================================================================
# DEPLOYMENT CHECKLIST
# =============================================================================
# Before running the agents, ensure you have:
# □ Copied this file to .env
# □ Filled in all required values
# □ Verified API keys are valid
# □ Checked database connectivity
# □ Confirmed MCP server access
# □ Tested API rate limits
# □ Set up proper error monitoring
