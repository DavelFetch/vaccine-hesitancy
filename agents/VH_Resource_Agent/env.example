# =============================================================================
# VH_RESOURCE_AGENT - ENVIRONMENT VARIABLES
# =============================================================================
# 
# This agent processes and searches vaccine-related documents using vector search.
# Copy this file to .env and fill in your actual values.
#
# IMPORTANT: Never commit your actual .env file to version control!
# =============================================================================

# =============================================================================
# QDRANT VECTOR DATABASE
# =============================================================================
# Used for vector similarity search of vaccine-related documents

QDRANT_URL=https://your-cluster-id.us-west-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# How to get this value:
# 1. Go to https://cloud.qdrant.io/
# 2. Create a free account
# 3. Create a new cluster
# 4. Copy your cluster URL and API key from the dashboard

# =============================================================================
# SMITHERY MCP SERVICES
# =============================================================================
# Provides MCP (Model Context Protocol) servers for Qdrant integration

SMITHERY_MCP_URL=https://server.smithery.ai/mcp-server-qdrant/mcp?api_key=YOUR_KEY&profile=YOUR_PROFILE
SMITHERY_QDRANT_API_KEY=your-smithery-api-key

# How to get these values:
# 1. Go to https://smithery.ai and create an account
# 2. Get your API key from your dashboard
# 3. Create a profile for Qdrant MCP server
# 4. Copy the MCP URL from your profile configuration

# =============================================================================
# ASI1 API (FETCH.AI)
# =============================================================================
# AI model service for intelligent document processing

ASI1_API_KEY=sk_your-asi1-api-key

# How to get this value:
# 1. Go to https://innovationlab.fetch.ai/
# 2. Sign up for an account
# 3. Navigate to ASI:One section
# 4. Generate your API key
# 5. Note: Rate limited to 6 requests/hour for free tier

# =============================================================================
# OPENAI API
# =============================================================================
# Advanced language model capabilities for document analysis

OPENAI_API_KEY=sk-proj-your-openai-api-key

# How to get this value:
# 1. Go to https://platform.openai.com/
# 2. Create an account and add billing information
# 3. Generate an API key in your dashboard
# 4. Note: OpenAI API is pay-per-use

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. Never commit your actual .env file to version control
# 2. Use strong, unique passwords for database connections
# 3. Monitor API usage to avoid unexpected charges
# 4. Keep your Qdrant API key secure
