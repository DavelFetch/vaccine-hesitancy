# =============================================================================
# VH_X_ANALYSIS_AGENT - ENVIRONMENT VARIABLES
# =============================================================================
# 
# This agent analyzes X (Twitter) social media data for vaccine sentiment and trends.
# Copy this file to .env and fill in your actual values.
#
# IMPORTANT: Never commit your actual .env file to version control!
# =============================================================================

# =============================================================================
# X (TWITTER) API CONFIGURATION
# =============================================================================
# These variables enable access to X (Twitter) data for social media sentiment
# analysis related to vaccine hesitancy.

# X API v2 credentials
X_API_KEY=your-x-api-key
X_API_SECRET=your-x-api-secret
X_ACCESS_TOKEN=your-x-access-token
X_ACCESS_SECRET=your-x-access-secret
X_BEARER_TOKEN=your-x-bearer-token

# How to get these values:
# 1. Go to https://developer.twitter.com/
# 2. Create a developer account and app
# 3. Apply for Elevated access (required for most endpoints)
# 4. Generate your API keys and tokens in your app settings
# 5. Note: X API has rate limits and requires approval for research use

# =============================================================================
# RAPIDAPI
# =============================================================================
# Provides access to various third-party services and APIs

RAPIDAPI_KEY=your-rapidapi-key

# How to get this value:
# 1. Go to https://rapidapi.com/
# 2. Sign up for an account
# 3. Subscribe to the APIs you need
# 4. Copy your API key from your dashboard

# =============================================================================
# SUPABASE DATABASE CONFIGURATION
# =============================================================================
# Stores vaccine hesitancy data and provides real-time database access

SUPABASE_ACCESS_TOKEN=sbp_your-access-token
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_DB_PASSWORD=your-database-password

# How to get these values:
# 1. Go to https://supabase.com and create/login to your project
# 2. Go to Settings > API to find your Project ID and API keys
# 3. Go to Settings > Database to find your database password

# =============================================================================
# SMITHERY API
# =============================================================================
# Provides MCP (Model Context Protocol) services for X/Twitter integration

SMITHERY_API_KEY=your-smithery-api-key

# How to get this value:
# 1. Go to https://smithery.ai and create an account
# 2. Get your API key from your dashboard

# =============================================================================
# ASI1 API (FETCH.AI)
# =============================================================================
# AI model service for intelligent social media analysis

ASI1_API_KEY=sk_your-asi1-api-key

# How to get this value:
# 1. Go to https://innovationlab.fetch.ai/
# 2. Sign up for an account
# 3. Navigate to ASI:One section
# 4. Generate your API key
# 5. Note: Rate limited to 6 requests/hour for free tier

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. Never commit your actual .env file to version control
# 2. Use strong, unique passwords for database connections
# 3. Monitor API usage to avoid unexpected charges
# 4. Keep your X API credentials secure
# 5. Be aware of X API rate limits and usage policies
